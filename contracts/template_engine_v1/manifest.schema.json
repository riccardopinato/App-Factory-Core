{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/riccardopinato/App-Factory-Core/blob/main/contracts/template_engine_v1/manifest.schema.json",
  "title": "App Factory Template Engine v1 - candidate static manifest",
  "description": "Declarative original app-native template metadata; schema compliance does not certify product implementation or commercial rights.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "template_id",
    "template_version",
    "app_id",
    "catalog_status",
    "category",
    "localization",
    "preview",
    "compatibility",
    "configuration",
    "installation",
    "access",
    "provenance"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "template_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*){2,6}$",
      "maxLength": 120
    },
    "template_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 30
    },
    "app_id": {
      "type": "string",
      "pattern": "^riccardopinato/[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "catalog_status": {
      "enum": [
        "research_candidate",
        "product_approved"
      ]
    },
    "category": {
      "enum": [
        "knowledge",
        "planner",
        "journal",
        "travel",
        "cooking",
        "photography",
        "study",
        "design",
        "utility",
        "other"
      ]
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_locale",
        "translations"
      ],
      "properties": {
        "default_locale": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "translations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z]{2}(-[A-Z]{2})?$": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "description",
                "preview_alt"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 360
                },
                "preview_alt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                }
              }
            }
          }
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "generated_in_app",
            "bundled_original"
          ]
        },
        "asset_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "bundled_original"
              }
            }
          },
          "then": {
            "required": [
              "asset_path",
              "sha256"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "asset_path"
                  ]
                },
                {
                  "required": [
                    "sha256"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_app_build",
        "platforms",
        "data_contract_revision",
        "required_capabilities",
        "target_locales"
      ],
      "properties": {
        "min_app_build": {
          "type": "integer",
          "minimum": 1
        },
        "max_app_build": {
          "type": "integer",
          "minimum": 1
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "android",
              "ios",
              "web"
            ]
          }
        },
        "data_contract_revision": {
          "type": "integer",
          "minimum": 1
        },
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{1,89}$"
          }
        },
        "target_locales": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "kind",
              "default"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,63}$"
              },
              "kind": {
                "enum": [
                  "boolean",
                  "text",
                  "integer",
                  "choice"
                ]
              },
              "default": {
                "type": [
                  "string",
                  "integer",
                  "boolean"
                ]
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                }
              },
              "min": {
                "type": "integer"
              },
              "max": {
                "type": "integer"
              },
              "max_length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2000
              }
            }
          }
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "strategy",
        "scope",
        "write_targets",
        "confirmation_required",
        "replay_policy",
        "removal_policy"
      ],
      "properties": {
        "adapter_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{1,89}$"
        },
        "strategy": {
          "const": "staged_validate_atomic_commit"
        },
        "scope": {
          "enum": [
            "private",
            "shared_explicit"
          ]
        },
        "write_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          }
        },
        "confirmation_required": {
          "const": true
        },
        "replay_policy": {
          "const": "idempotent_install_receipt"
        },
        "removal_policy": {
          "const": "detach_keep_user_data"
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier"
      ],
      "properties": {
        "tier": {
          "enum": [
            "free",
            "paid_once"
          ]
        },
        "entitlement_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{1,89}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "external_assets_embedded",
        "reference_ids",
        "rights_status"
      ],
      "properties": {
        "origin": {
          "const": "original_app_native"
        },
        "external_assets_embedded": {
          "const": false
        },
        "reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 30,
          "items": {
            "type": "string",
            "pattern": "^TPLUX-REF-[0-9]{4,}$"
          }
        },
        "rights_status": {
          "enum": [
            "first_party_confirmed",
            "first_party_pending_review"
          ]
        }
      }
    }
  }
}
