{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"App Factory Golden Registry",
  "type":"object","additionalProperties":false,
  "required":["registry_version","updated_at","master_version","index_version","goldens"],
  "properties":{
    "registry_version":{"const":2},
    "updated_at":{"type":"string","format":"date"},
    "master_version":{"type":["string","integer"]},
    "index_version":{"type":"integer","minimum":1},
    "goldens":{"type":"array","minItems":1,"items":{"$ref":"golden_manifest.schema.json"}}
  }
}
