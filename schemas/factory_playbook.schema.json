{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/riccardopinato/App-Factory-Core/schemas/factory_playbook.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "authority",
    "required_inputs",
    "steps",
    "completion"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "const": "PROCESS_ONLY"
    },
    "required_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "gate",
          "parallel_safe"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "type": "string",
            "enum": [
              "NONE",
              "STOP_ON_FAILURE",
              "STOP_ON_BLOCKER",
              "EXACT_HEAD_GREEN",
              "EVIDENCE_REQUIRED"
            ]
          },
          "parallel_safe": {
            "type": "boolean"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "completion": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
