{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/riccardopinato/App-Factory-Core/schemas/golden_manifest.schema.json",
  "title": "App Factory Golden Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "version",
    "status",
    "category",
    "path",
    "last_reviewed",
    "provider_sensitive",
    "freshness_status"
  ],
  "properties": {
    "id": {"type": "string","pattern": "^[a-z0-9_]+$"},
    "title": {"type": "string","minLength": 1},
    "version": {"type": "string","minLength": 1},
    "status": {"type": "string","minLength": 1},
    "category": {"type": "string","minLength": 1},
    "path": {"type": "string","pattern": "^golden/"},
    "last_reviewed": {"type": "string","format": "date"},
    "provider_sensitive": {"type": "boolean"},
    "freshness_status": {"enum": ["CURRENT","NEEDS_REVIEW","STALE","DEPRECATED"]},
    "tested_package_version": {"type": ["string","null"]},
    "replacement": {"type": ["string","null"]}
  }
}
